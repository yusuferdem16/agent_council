# Copy this file to .env and fill in your own values.
# This file is git-safe and should not be committed.

# Path to your local Obsidian vault (or any folder of markdown files).
OBSIDIAN_VAULT_PATH=/absolute/path/to/your/obsidian/vault
# Alternative variable also supported:
# VAULT_PATH=/absolute/path/to/your/obsidian/vault

# API key for Gemini, used by the orchestrator/editor/reviewer agents (google-adk).
GOOGLE_API_KEY=your-google-api-key

# API key for Groq, used by the edit_markdown_with_groq tool.
GROQ_API_KEY=your-groq-api-key

# Optional: override the Groq model used for edits (defaults to openai/gpt-oss-120b).
# GROQ_MODEL=openai/gpt-oss-120b
